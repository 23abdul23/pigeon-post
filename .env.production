# Non-secret. PLACEHOLDERS: fill from the deployed stack outputs (UserPoolId, UserPoolClientId, CognitoDomain, ApiUrl) before `npm run build`.
VITE_COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=REPLACE_ME
VITE_COGNITO_DOMAIN=https://REPLACE_ME.auth.us-east-1.amazoncognito.com
VITE_API_URL=https://REPLACE_ME.execute-api.us-east-1.amazonaws.com
# Push notifications for "A letter arrived". Keep false until android/app/google-services.json is in place, the Gradle google-services
# plugin applies, and a build has been run on a device: with no Firebase config the plugin's register() crashes the app.
VITE_PUSH_ENABLED=false
